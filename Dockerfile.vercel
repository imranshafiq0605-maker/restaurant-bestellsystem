FROM node:24.22.1-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV LAROSA_CONTAINER=1
COPY package.json package-lock.json ./
COPY tools/next-eslint-glob ./tools/next-eslint-glob
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:24.22.1-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=80
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/scripts/check-node-version.mjs ./scripts/check-node-version.mjs
USER node
EXPOSE 80
CMD ["sh", "-c", "node scripts/check-node-version.mjs && exec node server.js"]
